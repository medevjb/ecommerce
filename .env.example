# Frontend Environment Configuration
# Copy this file to .env.local

# Laravel API URL used by the Next.js staff proxy
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1
# Set only when trusted ingress overwrites this header and blocks direct access.
TRUSTED_CLIENT_IP_HEADER=
# Staff workspace brand from the backend PRD
ADMIN_BRAND_NAME=SHOP.CO
# Browser URL for existing storefront and customer requests
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public Store Configuration
NEXT_PUBLIC_APP_NAME="AURA Commerce"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# Analytics & Integrations (Optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
